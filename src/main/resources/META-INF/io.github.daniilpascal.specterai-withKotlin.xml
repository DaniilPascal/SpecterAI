<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <lang.inspectionSuppressor language="kotlin" implementationClass="io.github.daniilpascal.specterai.highlight.AiCommandInspectionSuppressor"/>
    <annotator language="kotlin" implementationClass="io.github.daniilpascal.specterai.highlight.AiCommandAnnotator"/>
  </extensions>
  
  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK2="true"/>
  </extensions>
</idea-plugin>
